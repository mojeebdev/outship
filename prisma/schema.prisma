generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ShipType {
  RELEASE
  MERGE
}

model Builder {
  id             String    @id @default(cuid())
  githubId       Int       @unique
  githubLogin    String    @unique
  installationId Int?
  walletAddress  String?
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastShipDate   DateTime?
  score          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  ships          Ship[]

  @@index([score])
}

model Ship {
  id          String       @id @default(cuid())
  builder     Builder      @relation(fields: [builderId], references: [id])
  builderId   String
  repo        String
  shipType    ShipType
  identifier  String
  commitSha   String
  shippedAt   DateTime
  createdAt   DateTime     @default(now())
  attestation Attestation?

  @@unique([repo, shipType, identifier])
  @@index([builderId, shippedAt])
}

model Attestation {
  id            String   @id @default(cuid())
  ship          Ship     @relation(fields: [shipId], references: [id])
  shipId        String   @unique
  easUid        String   @unique
  txHash        String
  chain         String   @default("base")
  scoreSnapshot Int
  attestedAt    DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ── Word (word.outship.dev) ──────────────────────────────────────────────────

/// One opt-in entry per normalised hostname for Word's homepage leaderboard.
/// Rows only ever exist because someone asked to be listed, and every count is
/// computed server-side — client-supplied numbers are never stored.
model WordSite {
  hostname      String   @id
  url           String
  wordCount     Int
  charCount     Int
  scanCount     Int      @default(1)
  listedAt      DateTime @default(now())
  lastScannedAt DateTime @default(now())

  @@index([wordCount])
}

/// Fixed-window rate limit counters for Word's public endpoints.
model WordRateLimit {
  key         String @id
  windowStart Int
  count       Int    @default(0)
}

/// A saved, shareable scan result. Created for every successful scan; the id is
/// opaque and unguessable, and becomes public only when someone shares or
/// downloads it. Stores the server-calculated numbers as a stable snapshot, so
/// an old share link keeps saying what it said when it was made.
model WordResult {
  id                   String   @id
  url                  String
  hostname             String
  isHomepage           Boolean
  words                Int
  characters           Int
  scanMs               Int
  benchmarkWords       Int
  benchmarkVersion     String
  comparisonDirection  String
  comparisonDifference Int
  createdAt            DateTime @default(now())

  @@index([createdAt])
}
