{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "outship",
	// worker.js wraps OpenNext's generated .open-next/worker.js to add the
	// daily cron below; every request is still served by OpenNext.
	"main": "worker.js",
	"compatibility_date": "2026-01-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// The actual build step for Cloudflare's Git-connected "Workers Builds"
	// is configured in the dashboard (Settings -> Build), not here:
	// Build command: npm run cf-typegen && npx opennextjs-cloudflare build
	// Deploy command: npx wrangler deploy
	// (wrangler.jsonc's own `build.command` hook isn't honored by that
	// pipeline, and re-triggers itself oddly when combined with
	// `wrangler types`, so it's intentionally left out here.)
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "outship-db",
			"database_id": "fa90a9a2-77ac-4594-ae24-b5ceea9f3e7e",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			// Next.js page/route cache (see open-next.config.ts). Create with
			// `wrangler r2 bucket create outship-cache`.
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "outship-cache"
		}
	],
	"kv_namespaces": [
		{
			// Tag-based cache revalidation bookkeeping (see open-next.config.ts).
			"binding": "NEXT_TAG_CACHE_KV",
			"id": "1f79279d71ee40bbb6c39f829a7c2a46"
		}
	],
	"send_email": [
		{
			// Cloudflare Email Service. The binding can only send as these two
			// addresses, so nothing in this Worker can send mail as anyone else.
			// Replies go to support@mail.outship.dev via Reply-To.
			"name": "EMAIL",
			"allowed_sender_addresses": [
				"welcome@mail.outship.dev",
				"recap@mail.outship.dev",
				"reminder@mail.outship.dev",
				"mojeeb@mail.outship.dev",
				"invite@mail.outship.dev"
			]
		}
	],
	"triggers": {
		// 00:05 UTC daily: end stale streaks and award the previous UTC day Shipmarks
		// (src/lib/expire-streaks.ts).
		// Mondays 09:00-11:00 UTC hourly: the weekly recap
		// (src/lib/email/weekly-recap.ts). Runs three times so a send that
		// stops partway resumes; anyone already sent this week is skipped.
		// */2: one slice of the 12-month backfill (src/lib/backfill.ts), until
		// every installation's history is in; an idle run costs a couple of
		// queries. */10: the install reminder and the history-ready email.
		"crons": ["5 0 * * *", "0 9-11 * * 1", "*/2 * * * *", "*/10 * * * *"]
	},
	// Plain, non-secret settings. keep_vars leaves any variable set in the
	// dashboard alone on deploy (secrets are never touched by either).
	"keep_vars": true,
	"vars": {
		// Official OUTSHIP token on Base, launched via o1 Exchange.
		"OUTSHIP_TOKEN_ADDRESS": "0xb28b07a03f0bcab161032fed9d318be38a06aa01",
		// For the admin panel's visitor numbers (src/lib/cf-analytics.ts). An
		// account id isn't a secret: it's in every dashboard URL. The API token
		// that reads analytics is the CLOUDFLARE_ANALYTICS_TOKEN secret.
		"CLOUDFLARE_ACCOUNT_ID": "1c44f0a287a8d8b44aa136f42ae9e64b",
		// GitHub requests per 2-minute backfill run (src/lib/backfill.ts). The
		// code's default of 12 suits the free plan's 50 subrequests. On the paid
		// plan's 1,000, each page costs about 6 (the GitHub call plus the D1
		// reads and writes that store it), so 120 pages (~720) leaves headroom:
		// a run that hits the limit fails partway. Faster imports come from
		// running more often, not from bigger runs: 3,600 GitHub requests an
		// hour, under GitHub's 5,000 per installation, and a rate limit only
		// pauses the import until the next run.
		"BACKFILL_REQUEST_BUDGET": "120"
	},
	"observability": {
		"enabled": true
	}
}
