{
  "name": "outship",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:word && npm run test:lib",
    "test:word": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --test \"src/lib/word/__tests__/*.test.ts\"",
    "test:lib": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --test \"src/lib/__tests__/*.test.ts\" \"src/lib/attest/__tests__/*.test.ts\"",
    "test:contracts": "cd contracts && forge test",
    "verify:benchmark": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs scripts/verify-benchmark.mjs",
    "preview": "npm run cf-typegen && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run cf-typegen && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "testimonial": "node scripts/add-testimonial.mjs",
    "rescore": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs scripts/rescore-all.mjs",
    "backfill:shipmarks": "node scripts/backfill-shipmarks.mjs",
    "verify:legacy-attestations": "node scripts/verify-legacy-attestations.mjs",
    "flatten:contracts": "cd contracts && forge flatten src/OutshipShipResolver.sol -o remix/OutshipShipResolver.flat.sol"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.107.1",
    "htmlparser2": "^12.0.0",
    "next": "^16.4.6",
    "node-html-markdown": "^1.3.0",
    "ox": "0.14.65",
    "prisma": "^6.19.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.19",
    "wagmi": "^3.7.11"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "wrangler": "4.162.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "esbuild": true,
    "workerd": true,
    "keccak": false,
    "secp256k1": false
  }
}
